#!/usr/bin/env python3
"""dsh-acp launcher: runs dsh-acp.mjs, the bridge to the DeepSeek Harness App, under Node.

Clients that start `python3 bridges/dsh-acp` keep working; the bridge itself is dsh-acp.mjs beside this file.
Node: $DSH_ACP_NODE, else a Node 22+ on PATH or from Homebrew, else the DSH App's own runtime (its Electron
binary run as Node), which every installed App has.
"""
import os
import shutil
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
SCRIPT = os.path.join(HERE, "dsh-acp.mjs")
APP = os.environ.get("DSH_APP") or "/Applications/DeepSeek Harness.app"


def usable(node):
    if not node or not os.access(node, os.X_OK):
        return False
    try:
        out = subprocess.run([node, "-p", "process.versions.node"], capture_output=True, text=True, timeout=10).stdout
        return int(out.strip().split(".")[0]) >= 22  # global WebSocket with headers
    except (OSError, ValueError, subprocess.SubprocessError):
        return False


for node in (os.environ.get("DSH_ACP_NODE"), shutil.which("node"), "/opt/homebrew/bin/node", "/usr/local/bin/node"):
    if usable(node):
        os.execv(node, [node, SCRIPT, *sys.argv[1:]])

electron = os.path.join(APP, "Contents", "MacOS", "DeepSeek Harness")
if os.access(electron, os.X_OK):
    os.environ["ELECTRON_RUN_AS_NODE"] = "1"
    os.execv(electron, [electron, SCRIPT, *sys.argv[1:]])
sys.stderr.write("dsh-acp: no Node.js 22+ found and no DeepSeek Harness App to run the bridge with\n")
sys.exit(1)
