#!/usr/bin/env python3
"""dsh-acp: DeepSeek Harness as an ACP agent (stdio JSON-RPC), for Tianshu and other ACP clients.

Each turn runs DSH's own headless profile, `dsh --profile headless --json [--session-id X] -`,
in the session's directory, and streams its run events back as ACP updates. Nothing of DSH is
patched: sessions are DSH sessions in ~/.dsh/sessions. After a new session's first turn the
bridge drops a marker in $DSH_HOME/adopt-queue/ so the dsh-session-adopt plugin lists it in the
DSH desktop sidebar (on the App's next start when it is open), as dsh-dispatch.py does.

A new session has a provisional id until its first turn; the mapping to DSH's session id is
kept in ~/.local/state/dsh-acp/sessions.json so a client can resume by the id it was given.

Models: DSH has no model flag. A run takes the profile's `agent-default-model` row, and a resumed
session is moved onto it as well. The bridge lists the models the headless profile composes (its
`dsh --dump-config` provider rows) and runs a turn on the chosen one with a `--patch` overlay that
replaces that row. A session continued from the DSH App keeps the model its log last recorded.

Environment: DSH_BIN (default: dsh on PATH), DSH_HOME (default ~/.dsh).
"""
import collections, glob, json, os, plistlib, re, shutil, signal, subprocess, sys, threading, time, uuid

VERSION = "0.1.0"
DSH = os.environ.get("DSH_BIN") or "dsh"
DSH_HOME = os.environ.get("DSH_HOME") or os.path.join(os.path.expanduser("~"), ".dsh")
STATE = os.path.join(os.path.expanduser("~"), ".local", "state", "dsh-acp", "sessions.json")
PATCHES = os.path.join(os.path.dirname(STATE), "patches")

_out = threading.Lock()
_state_lock = threading.Lock()
SESS = {}  # acp id -> {"dsh": session id or None, "cwd", "model", "effort", "proc", "cancelled"}


def log(*a):
    print("[dsh-acp]", *a, file=sys.stderr, flush=True)


def send(msg):
    data = json.dumps(msg, ensure_ascii=False)
    with _out:
        sys.stdout.write(data + "\n")
        sys.stdout.flush()


def update(sid, upd):
    send({"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": sid, "update": upd}})


def text_chunk(kind, text):
    return {"sessionUpdate": kind, "content": {"type": "text", "text": text}}


# ------------------------------------------------------------------ state
def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def remember(acp_id, **fields):
    with _state_lock:
        st = load_state()
        st[acp_id] = {**(st.get(acp_id) or {}), **fields}
        os.makedirs(os.path.dirname(STATE), exist_ok=True)
        tmp = STATE + ".tmp"
        with open(tmp, "w") as f:
            json.dump(st, f)
        os.replace(tmp, STATE)


def resolve(acp_id, cwd=None):
    s = SESS.get(acp_id)
    if s is None:
        hit = load_state().get(acp_id) or {}
        dsh_id = hit.get("dsh") or (acp_id if acp_id.startswith("session-") else None)
        s = SESS.setdefault(acp_id, {"dsh": dsh_id, "cwd": hit.get("cwd") or cwd,
                                     "model": hit.get("model"), "effort": hit.get("effort")})
    if cwd and not s.get("cwd"):
        s["cwd"] = cwd
    return s


def adopt(dsh_id, cwd):
    """Queue the session for the desktop sidebar (dsh-session-adopt reads names without a dot)."""
    queue = os.path.join(DSH_HOME, "adopt-queue")
    os.makedirs(queue, exist_ok=True)
    tmp = os.path.join(queue, "." + dsh_id + ".tmp")
    with open(tmp, "w") as f:
        f.write(cwd + "\n")
    os.rename(tmp, os.path.join(queue, dsh_id))


# ------------------------------------------------------------------ session log -> replay
def session_file(dsh_id):
    for pattern in ("session.v4.jsonl.zstd", "session.jsonl.zstd"):
        hits = glob.glob(os.path.join(DSH_HOME, "sessions", "*", dsh_id, pattern))
        if hits:
            return hits[0]
    return None


def read_records(path):
    from compression import zstd  # Python 3.14+

    with open(path, "rb") as f:
        data = f.read()
    out = b""
    while data:
        d = zstd.ZstdDecompressor()
        out += d.decompress(data)
        data = d.unused_data
    for line in out.decode("utf-8", "replace").splitlines():
        try:
            yield json.loads(line)
        except ValueError:
            continue


def tool_kind(name):
    n = (name or "").lower()
    if n in ("bash", "shell", "exec"):
        return "execute"
    if n in ("read", "view", "read_file"):
        return "read"
    if n in ("edit", "write", "apply_patch", "multi_edit"):
        return "edit"
    if n in ("grep", "glob", "search", "web_search"):
        return "search"
    return "other"


def tool_title(name, args):
    if isinstance(args, str):
        try:
            args = json.loads(args)
        except ValueError:
            args = {}
    args = args if isinstance(args, dict) else {}
    hint = args.get("command") or args.get("path") or args.get("file_path") or args.get("pattern") or args.get("query") or ""
    first = (str(hint).strip().splitlines() or [""])[0][:120]
    return (name + (": " + first if first else "")), args


def replay(acp_id, dsh_id):
    """Replay the session's log as ACP updates; returns the model selection it last recorded."""
    path = session_file(dsh_id)
    if not path:
        return None
    selection = None
    for rec in read_records(path):
        kind, data = rec.get("type"), rec.get("data") or {}
        if kind in ("model/selection", "request/context") and data.get("provider") and data.get("model"):
            # a request names its model but not its effort: the effort stays the one last selected for it
            same = selection and (selection["provider"], selection["model"]) == (data["provider"], data["model"])
            selection = {**(selection if same else {}), **data}
        if kind == "user/message" and (data.get("source") or {}).get("kind") == "user":
            text = "\n".join(c.get("text", "") for c in data.get("content") or [] if c.get("type") == "text").strip()
            if text:
                update(acp_id, text_chunk("user_message_chunk", text))
        elif kind == "assistant/message":
            for c in (data.get("message") or {}).get("content") or []:
                if c.get("type") == "text" and c.get("text"):
                    update(acp_id, text_chunk("agent_message_chunk", c["text"]))
                elif c.get("type") == "reasoning" and c.get("text"):
                    update(acp_id, text_chunk("agent_thought_chunk", c["text"]))
                elif c.get("type") == "tool-call":
                    title, args = tool_title(c.get("name"), c.get("arguments"))
                    update(acp_id, {"sessionUpdate": "tool_call", "toolCallId": c.get("id") or str(uuid.uuid4()),
                                    "title": title, "kind": tool_kind(c.get("name")), "status": "completed", "rawInput": args})
        elif kind == "tool/result":
            msg = data.get("message") or {}
            text = "\n".join(c.get("text", "") for c in msg.get("content") or [] if c.get("type") == "text")
            update(acp_id, {"sessionUpdate": "tool_call_update", "toolCallId": msg.get("toolCallId") or "",
                            "status": "failed" if msg.get("isError") else "completed",
                            **({"content": [{"type": "content", "content": {"type": "text", "text": text[:20000]}}]} if text else {})})
    return selection


# ------------------------------------------------------------------ models
# Effort names as the client already translates them (Low, High, Max...), as the other bridges send them.
EFFORT_LABELS = {"low": "Low", "medium": "Medium", "high": "High", "xhigh": "Extra High", "max": "Max"}
_catalog = {"key": None, "value": None, "until": 0.0}
_catalog_lock = threading.Lock()


def _catalog_key():
    """The catalog changes when the headless profile or DSH itself does (magpie edits the profile)."""
    paths = [os.path.join(DSH_HOME, "profiles", "headless", n) for n in ("cordis.patch.yml", "package.json")]
    paths.append(os.path.realpath(shutil.which(DSH) or DSH))
    key = []
    for p in paths:
        try:
            key.append(os.stat(p).st_mtime_ns)
        except OSError:
            key.append(None)
    return tuple(key)


def _load_dump(text):
    import yaml

    class Loader(yaml.SafeLoader):
        pass

    # `!!js` rows are expressions DSH evaluates at boot; the catalog needs none of them.
    Loader.add_constructor("tag:yaml.org,2002:js", lambda loader, node: {"$js": loader.construct_scalar(node)})
    return yaml.load(text, Loader=Loader)


def catalog():
    """{"models": [{id, provider, model, name, efforts}], "default": {provider, model, reasoningEffort?}}"""
    key = _catalog_key()
    with _catalog_lock:
        if _catalog["key"] == key and time.monotonic() < _catalog["until"]:
            return _catalog["value"]
        value = {"models": [], "default": {}}
        try:
            out = subprocess.run([DSH, "--profile", "headless", "--dump-config"], capture_output=True, text=True,
                                 timeout=30)
            rows = _load_dump(out.stdout) if out.returncode == 0 else None
            if rows is None:
                raise RuntimeError("dump-config exited %s" % out.returncode)
        except Exception as e:  # noqa: BLE001 - no catalog is a session on DSH's own default
            log("catalog:", e)
            # a failing DSH is asked again in a minute, not on every request
            _catalog.update(key=key, value=value, until=time.monotonic() + 60)
            return value
        for row in rows if isinstance(rows, list) else []:
            if not isinstance(row, dict) or row.get("disabled") is True:
                continue
            cfg = row.get("config") if isinstance(row.get("config"), dict) else {}
            if row.get("id") == "agent-default-model":
                value["default"] = {k: cfg[k] for k in ("provider", "model", "reasoningEffort") if isinstance(cfg.get(k), str)}
            providers = cfg.get("providers")
            for pid, prov in (providers.items() if isinstance(providers, dict) else []):
                for m in (prov.get("models") if isinstance(prov, dict) else None) or []:
                    if not isinstance(m, dict) or not isinstance(m.get("id"), str):
                        continue
                    efforts = m.get("reasoningEfforts")
                    value["models"].append({"id": pid + "/" + m["id"], "provider": pid, "model": m["id"],
                                            "name": str(m.get("name") or m["id"]),
                                            "group": str(prov.get("displayName") or pid),
                                            "efforts": [e for e in efforts if isinstance(e, str)]
                                            if isinstance(efforts, (dict, list)) else []})
        names = collections.Counter(m["name"] for m in value["models"])
        for m in value["models"]:
            if names[m["name"]] > 1:
                m["name"] += " · " + m["group"]
        d = value["default"]
        if d.get("provider") and d.get("model") and not any(m["id"] == default_id(value) for m in value["models"]):
            value["models"].insert(0, {"id": default_id(value), "provider": d["provider"], "model": d["model"],
                                       "name": d["model"], "group": d["provider"], "efforts": []})
        _catalog.update(key=key, value=value, until=float("inf"))
        return value


def default_id(cat):
    d = cat["default"]
    return d["provider"] + "/" + d["model"] if d.get("provider") and d.get("model") else None


def find_model(cat, mid):
    return next((m for m in cat["models"] if m["id"] == mid), None)


def selected_model(s, cat):
    """The session's model: chosen (and still listed), else the profile's default, else the first listed."""
    return (find_model(cat, s.get("model")) or find_model(cat, default_id(cat))
            or (cat["models"][0] if cat["models"] else None))


def effort_now(s, m, cat):
    """The effort a turn on this model runs at: chosen if the model has it, else the profile's for its own
    default model, else High (or the middle one)."""
    efs = (m or {}).get("efforts") or []
    if not efs:
        return None
    if s.get("effort") in efs:
        return s["effort"]
    if m["id"] == default_id(cat) and cat["default"].get("reasoningEffort") in efs:
        return cat["default"]["reasoningEffort"]
    return "high" if "high" in efs else efs[len(efs) // 2]


def models_state(s):
    cat = catalog()
    sel = selected_model(s, cat)
    if sel is None:
        return None

    def meta(m):
        if not m["efforts"]:
            return {"supportsReasoningEffort": False}
        return {"reasoningEfforts": [{"value": v, "label": EFFORT_LABELS.get(v, v)} for v in m["efforts"]],
                "reasoningEffort": effort_now(s, m, cat)}

    return {"currentModelId": sel["id"],
            "availableModels": [{"modelId": m["id"], "name": m["name"], "_meta": meta(m)} for m in cat["models"]]}


def config_options(s):
    cat = catalog()
    sel = selected_model(s, cat)
    if sel is None:
        return []
    opts = [{"id": "model", "name": "Model", "category": "model", "type": "select", "currentValue": sel["id"],
             "options": [{"value": m["id"], "name": m["name"]} for m in cat["models"]]}]
    if sel["efforts"]:
        opts.append({"id": "effort", "name": "Effort", "category": "thought_level", "type": "select",
                     "currentValue": effort_now(s, sel, cat),
                     "options": [{"value": v, "name": EFFORT_LABELS.get(v, v)} for v in sel["efforts"]]})
    return opts


def session_state(s):
    out = {"configOptions": config_options(s)}
    models = models_state(s)
    if models:
        out["models"] = models
    return out


def model_patch(s):
    """An overlay running this turn on the session's model, or None when nothing was chosen (DSH's default)."""
    if s.get("model") is None and s.get("effort") is None:
        return None
    cat = catalog()
    m = selected_model(s, cat)
    if m is None:
        return None
    lines = ["- id: agent-default-model", "  config:",
             "    provider: " + json.dumps(m["provider"]), "    model: " + json.dumps(m["model"])]
    effort = effort_now(s, m, cat)
    if effort:
        lines.append("    reasoningEffort: " + json.dumps(effort))
    os.makedirs(PATCHES, exist_ok=True)
    path = os.path.join(PATCHES, uuid.uuid4().hex + ".yml")
    with open(path, "w") as f:
        f.write("\n".join(lines) + "\n")
    return path


# ------------------------------------------------------------------ prompt text
# The client's notes (its collaboration tools, runtime info) are for agents that can use them; DSH
# cannot reach those tools, and the notes would show in the DSH App as part of your message.
_NOTES = re.compile(r"\s*<(t3_code_instructions|runtime_info|pull_request_linking)>.*?</\1>\s*", re.S)
_REQUEST = re.compile(r"<user_request>\n?(.*?)\n?</user_request>", re.S)


def prompt_text(blocks):
    parts = []
    for b in blocks or []:
        t = b.get("type")
        if t == "text":
            parts.append(b.get("text") or "")
        elif t == "resource_link":
            parts.append(b.get("uri") or "")
        elif t == "resource":
            r = b.get("resource") or {}
            parts.append(r.get("text") or r.get("uri") or "")
    text = "\n".join(x for x in parts if x)
    m = _REQUEST.search(text)
    if m:
        text = text[: m.start()] + m.group(1) + text[m.end():]
    return _NOTES.sub("\n\n", text).strip()


# ------------------------------------------------------------------ one turn
def run_turn(acp_id, s, text, cwd):
    patch = model_patch(s)
    try:
        return _run_turn(acp_id, s, text, cwd, patch)
    finally:
        if patch:
            try:
                os.unlink(patch)
            except OSError:
                pass


def _run_turn(acp_id, s, text, cwd, patch):
    cmd = [DSH, "--profile", "headless"] + (["--patch", patch] if patch else []) + ["--json"]
    if s.get("dsh"):
        cmd += ["--session-id", s["dsh"]]
    proc = subprocess.Popen(cmd + ["-"], stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            cwd=cwd, text=True, bufsize=1, start_new_session=True)
    s["proc"] = proc
    errors = []
    threading.Thread(target=lambda: errors.append(proc.stderr.read()), daemon=True).start()
    proc.stdin.write(text)
    proc.stdin.close()
    reason, error, new_id = None, None, None
    for line in proc.stdout:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        kind = e.get("type")
        if kind == "session":
            new_id = e.get("sessionId")
        elif kind == "text" and e.get("text"):
            update(acp_id, text_chunk("agent_message_chunk", e["text"]))
        elif kind == "thinking" and e.get("text"):
            update(acp_id, text_chunk("agent_thought_chunk", e["text"]))
        elif kind == "tool_call":
            title, args = tool_title(e.get("tool"), e.get("input"))
            update(acp_id, {"sessionUpdate": "tool_call", "toolCallId": e.get("callId") or str(uuid.uuid4()),
                            "title": title, "kind": tool_kind(e.get("tool")), "status": "in_progress", "rawInput": args})
        elif kind == "tool_result":
            result = e.get("result")
            result = result if isinstance(result, str) else json.dumps(result, ensure_ascii=False)
            update(acp_id, {"sessionUpdate": "tool_call_update", "toolCallId": e.get("callId") or "",
                            "status": "completed" if e.get("status") == "completed" else "failed",
                            **({"content": [{"type": "content", "content": {"type": "text", "text": result[:20000]}}]} if result else {})})
        elif kind == "final":
            reason = (e.get("reason") or {}).get("kind")
        elif kind == "error":
            error = e.get("message") or "DSH reported an error"
    code = proc.wait()
    s["proc"] = None
    if error is None and code not in (0, None) and not s.get("cancelled"):
        error = (errors[0] if errors else "").strip().splitlines()[-1:] or ["dsh exited with %s" % code]
        error = error[0] if isinstance(error, list) else error
    return new_id, reason, error


def h_prompt(p):
    acp_id = p["sessionId"]
    s = resolve(acp_id)
    text = prompt_text(p.get("prompt"))
    if not text:
        return {"stopReason": "end_turn"}
    cwd = s.get("cwd") or os.getcwd()
    s["cancelled"] = False
    new_id, reason, error = run_turn(acp_id, s, text, cwd)
    moved = re.search(r'was recorded in "(.+?)", not "', error or "")
    if moved:  # a resumed session runs only from the directory it was recorded in
        cwd = s["cwd"] = moved.group(1)
        new_id, reason, error = run_turn(acp_id, s, text, cwd)
    if new_id and not s.get("dsh"):
        s["dsh"] = new_id
        remember(acp_id, dsh=new_id, cwd=cwd)
        try:
            adopt(new_id, cwd)
        except OSError as e:
            log("adopt:", e)
    if error and not s.get("cancelled"):
        if "active write handle" in error:
            error = "This session is open in the DSH App, which holds it for writing. Quit DSH or start a new session."
        update(acp_id, text_chunk("agent_message_chunk", "\n\n" + error))
    if s.get("cancelled"):
        return {"stopReason": "cancelled"}
    return {"stopReason": "max_tokens" if reason == "max_tokens" else "end_turn"}


def dsh_version():
    """DSH's own version: its app's, else `dsh --version`; the bridge's when neither answers."""
    try:
        real = os.path.realpath(shutil.which(DSH) or DSH)
        app = real[:real.find(".app/") + 4] if ".app/" in real else None
        if app:
            with open(os.path.join(app, "Contents", "Info.plist"), "rb") as f:
                version = plistlib.load(f).get("CFBundleShortVersionString")
            if version:
                return version
        out = subprocess.run([DSH, "--version"], capture_output=True, text=True, timeout=10).stdout.strip()
        if re.match(r"^\d+\.\d+\.\d+", out):
            return out.split()[0]
    except (OSError, ValueError, subprocess.SubprocessError, plistlib.InvalidFileException):
        pass
    return VERSION


# ------------------------------------------------------------------ handlers
def h_initialize(p):
    return {"protocolVersion": 1,
            "agentCapabilities": {"loadSession": True,
                                  "promptCapabilities": {"image": False, "audio": False, "embeddedContext": True},
                                  "mcpCapabilities": {"http": False, "sse": False}},
            "authMethods": [],
            "agentInfo": {"name": "dsh-acp", "title": "DeepSeek Harness", "version": dsh_version()}}


def h_new(p):
    acp_id = "dsh-new-" + uuid.uuid4().hex
    s = SESS[acp_id] = {"dsh": None, "cwd": p.get("cwd"), "model": None, "effort": None}
    return {"sessionId": acp_id, **session_state(s)}


def h_load(p):
    acp_id = p["sessionId"]
    s = resolve(acp_id, p.get("cwd"))
    recorded = replay(acp_id, s["dsh"]) if s.get("dsh") else None
    # Not chosen here: keep the model the session last ran on (in the App, say), when this profile has it.
    if recorded and s.get("model") is None:
        m = find_model(catalog(), recorded["provider"] + "/" + recorded["model"])
        if m:
            s["model"] = m["id"]
            if recorded.get("reasoningEffort") in m["efforts"]:
                s["effort"] = recorded["reasoningEffort"]
    return session_state(s)


def h_set_option(p):
    acp_id = p["sessionId"]
    s = resolve(acp_id)
    value = p.get("value")
    if p.get("configId") == "model":
        s["model"] = None if value in (None, "", "default") else str(value)
        # an effort the new model lacks falls back to the new model's own
        if s.get("effort") not in ((selected_model(s, catalog()) or {}).get("efforts") or []):
            s["effort"] = None
    elif p.get("configId") == "effort":
        s["effort"] = None if value in (None, "", "default") else str(value)
    remember(acp_id, model=s.get("model"), effort=s.get("effort"),
             **({"dsh": s["dsh"]} if s.get("dsh") else {}), **({"cwd": s["cwd"]} if s.get("cwd") else {}))
    return {"configOptions": config_options(s)}


def h_set_model(p):
    h_set_option({"sessionId": p["sessionId"], "configId": "model", "value": p.get("modelId")})
    return {}


def h_cancel(p):
    s = SESS.get(p.get("sessionId"))
    proc = s and s.get("proc")
    if proc and proc.poll() is None:
        s["cancelled"] = True
        try:
            os.killpg(proc.pid, signal.SIGINT)
        except OSError:
            proc.terminate()


HANDLERS = {"initialize": h_initialize, "session/new": h_new, "session/load": h_load, "session/prompt": h_prompt,
            "session/set_config_option": h_set_option, "session/set_model": h_set_model}
NOTIFICATIONS = {"session/cancel": h_cancel}


def handle(msg):
    method, mid, params = msg.get("method"), msg.get("id"), msg.get("params") or {}
    if mid is None:
        fn = NOTIFICATIONS.get(method)
        if fn:
            try:
                fn(params)
            except Exception as e:  # noqa: BLE001
                log(method, e)
        return
    fn = HANDLERS.get(method)
    if fn is None:
        return send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32601, "message": "Method not found: %s" % method}})
    try:
        send({"jsonrpc": "2.0", "id": mid, "result": fn(params)})
    except Exception as e:  # noqa: BLE001
        log("%s failed: %r" % (method, e))
        send({"jsonrpc": "2.0", "id": mid, "error": {"code": -32603, "message": "%s: %s" % (type(e).__name__, e)}})


def main():
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if "method" in msg:
            threading.Thread(target=handle, args=(msg,), daemon=True).start()


if __name__ == "__main__":
    main()
